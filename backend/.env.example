# Default STT + TTS provider. Create a key in the Gradium dashboard.
GRADIUM_API_KEY=
# Optional. Omit it to use the public voice_id from atlas.json.
GRADIUM_VOICE_ID=

# Required. TypeSafe Jev decides routing, initiative and speaking posture.
TYPESAFE_API_KEY=

# Required by the default Speaker, Worker, Notes, Board and Naming roles.
OPENAI_API_KEY=
# Optional LLM fallback. Required only when an opencode-zen/* model is selected.
OPENCODE_ZEN_API_KEY=

# Optional read-only research tools. Missing keys disable only the corresponding tool.
EXA_API_KEY=
JINKO_API_KEY=
