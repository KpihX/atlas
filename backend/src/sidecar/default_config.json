{
  "server": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "session": {
    "assistant_name": "Assistant",
    "language": "en",
    "notes_interval_seconds": 20
  },
  "policy": {
    "stable_floor_gap_seconds": 0.8,
    "direct_floor_gap_seconds": 0.3,
    "direct_force_after_seconds": 4,
    "proactive_force_after_seconds": 8,
    "wait_to_visual_fallback_seconds": 15,
    "direct_address_freshness_seconds": 20,
    "unsolicited_speech_cooldown_seconds": 90,
    "decision_debounce_seconds": 2,
    "decision_hard_ceiling_seconds": 5,
    "research_max_concurrency": 3,
    "max_tool_steps": 4,
    "max_spoken_words": 140
  },
  "storage": {
    "database_path": ""
  },
  "voice": {
    "stt": {
      "provider": "gradium",
      "endpoint": "wss://api.gradium.ai/api/speech/asr",
      "secret_env": "GRADIUM_API_KEY",
      "model": "default",
      "input_format": "pcm_24000",
      "language": "en",
      "delay_in_frames": 16,
      "rotate_after_seconds": 285
    },
    "tts": {
      "provider": "gradium",
      "endpoint": "wss://api.gradium.ai/api/speech/tts",
      "secret_env": "GRADIUM_API_KEY",
      "voice_id_env": "GRADIUM_VOICE_ID",
      "voice_id": "b35yykvVppLXyw_l",
      "model": "default",
      "output_format": "opus",
      "temperature": 0.9,
      "cfg_coef": 2.2,
      "padding_bonus": -0.5
    }
  },
  "decision": {
    "provider": "typesafe",
    "endpoint": "https://api.typesafe.ai/v1/systemone",
    "secret_env": "TYPESAFE_API_KEY",
    "model": "jev-latest",
    "addressed_threshold": 0.65
  },
  "llm": {
    "active_model": "opencode-zen-muse-spark-1-3",
    "utility_model": "opencode-zen-muse-spark-1-3",
    "timeout_seconds": 30,
    "utility_timeout_seconds": 12,
    "max_request_cost_usd": 6.0,
    "models": [
      {
        "id": "openai-gpt-5-6-luna",
        "provider": "openai",
        "model": "gpt-5.6-luna",
        "endpoint": "https://api.openai.com/v1/responses",
        "transport": "responses",
        "secret_env": "OPENAI_API_KEY",
        "reasoning_effort": "low",
        "max_output_tokens": 512,
        "input_usd_per_million_tokens": 1.0,
        "output_usd_per_million_tokens": 6.0
      },
      {
        "id": "opencode-zen-muse-spark-1-3",
        "provider": "opencode-zen",
        "model": "muse-spark-1.3",
        "endpoint": "https://opencode.ai/zen/v1/responses",
        "transport": "responses",
        "secret_env": "OPENCODE_ZEN_API_KEY",
        "reasoning_effort": "low",
        "max_output_tokens": 4096,
        "input_usd_per_million_tokens": 1.25,
        "output_usd_per_million_tokens": 4.25
      },
      {
        "id": "opencode-zen-mimo-v2-6-flash-free",
        "provider": "opencode-zen",
        "model": "mimo-v2.6-flash-free",
        "endpoint": "https://opencode.ai/zen/v1/chat/completions",
        "transport": "chat_completions",
        "secret_env": "OPENCODE_ZEN_API_KEY",
        "reasoning_effort": null,
        "max_output_tokens": 512,
        "input_usd_per_million_tokens": 0.0,
        "output_usd_per_million_tokens": 0.0
      },
      {
        "id": "opencode-zen-mimo-v2-5-free",
        "provider": "opencode-zen",
        "model": "mimo-v2.5-free",
        "endpoint": "https://opencode.ai/zen/v1/chat/completions",
        "transport": "chat_completions",
        "secret_env": "OPENCODE_ZEN_API_KEY",
        "reasoning_effort": null,
        "max_output_tokens": 512,
        "input_usd_per_million_tokens": 0.0,
        "output_usd_per_million_tokens": 0.0
      }
    ]
  },
  "tools": {
    "exa": {
      "enabled": true,
      "endpoint": "https://api.exa.ai/search",
      "secret_env": "EXA_API_KEY",
      "search_type": "auto",
      "num_results": 5
    },
    "jinko": {
      "enabled": true,
      "base_url": "https://api.gojinko.com",
      "secret_env": "JINKO_API_KEY"
    }
  }
}
